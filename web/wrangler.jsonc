{
  // Static-only Worker: Cloudflare serves the Vite build output, no server code.
  // Workers Builds runs `npm run build` and then `npx wrangler deploy` from web/.
  "name": "martian-map",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
